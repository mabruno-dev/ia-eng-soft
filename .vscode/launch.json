{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ReacTest: Extension Development Host (sample-app)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/fixtures/sample-app"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "reactest: build:ext"
    }
  ]
}

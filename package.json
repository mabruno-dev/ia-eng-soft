{
  "name": "reactest-agent",
  "displayName": "ReacTest-Agent",
  "description": "Gera testes Jest + React Testing Library para componentes React/TypeScript com uma pipeline agêntica com self-healing.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "reactest.generate",
        "title": "Gerar testes (Agent)",
        "category": "ReacTest"
      },
      {
        "command": "reactest.setOpenAIKey",
        "title": "Definir chave OpenAI",
        "category": "ReacTest"
      },
      {
        "command": "reactest.showOutput",
        "title": "Mostrar log dos agentes",
        "category": "ReacTest"
      },
      {
        "command": "reactest.listCopilotModels",
        "title": "Listar modelos do Copilot",
        "category": "ReacTest"
      },
      {
        "command": "reactest.runEvaluation",
        "title": "Rodar avaliação (Copilot)",
        "category": "ReacTest"
      },
      {
        "command": "reactest.generateClaudeCli",
        "title": "Gerar testes (Claude CLI)",
        "category": "ReacTest"
      },
      {
        "command": "reactest.showPanel",
        "title": "Mostrar painel da pipeline",
        "category": "ReacTest"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "reactest.generate",
          "when": "editorLangId == typescriptreact"
        }
      ],
      "explorer/context": [
        {
          "command": "reactest.generate",
          "when": "resourceExtname == .tsx",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "command": "reactest.generate",
          "when": "resourceExtname == .tsx",
          "group": "navigation@90"
        }
      ]
    },
    "configuration": {
      "title": "ReacTest-Agent",
      "properties": {
        "reactest.provider": {
          "type": "string",
          "enum": [
            "vscode",
            "claude-cli",
            "openai"
          ],
          "default": "vscode",
          "enumDescriptions": [
            "Modelos do GitHub Copilot via API vscode.lm (padrão)",
            "Claude Code (comando `claude`, logado com a assinatura) em modo headless",
            "API da OpenAI (chave em \"ReacTest: Definir chave OpenAI\")"
          ],
          "description": "Provedor do LLM usado pelos agentes."
        },
        "reactest.model": {
          "type": "string",
          "default": "",
          "description": "Modelo. Copilot: família (ex.: gpt-4o, claude-sonnet-4); vazio = primeiro disponível. Claude CLI: alias ou nome (ex.: sonnet, opus); vazio = sonnet. OpenAI: nome do modelo; vazio = gpt-4o."
        },
        "reactest.fallbackModel": {
          "type": "string",
          "default": "opus",
          "description": "Claude CLI: modelo usado quando o filtro de segurança do Claude recusa o modelo principal duas vezes (vazio desativa o fallback)."
        },
        "reactest.allowMiniModels": {
          "type": "boolean",
          "default": false,
          "description": "Permite modelos de família \"mini\" (ex.: gpt-4o-mini) na avaliação com o Copilot."
        },
        "reactest.maxIterations": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Máximo de iterações de self-healing (0 desativa o reparo)."
        },
        "reactest.maxAgentSteps": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 30,
          "description": "Máximo de passos (chamadas ao LLM) por agente."
        },
        "reactest.enableElicitation": {
          "type": "boolean",
          "default": true,
          "description": "Pergunta regras de negócio antes de gerar (agente 02)."
        },
        "reactest.enableVerifier": {
          "type": "boolean",
          "default": true,
          "description": "Roda o Verificador (mutation testing e test smells, agente 06)."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run typecheck",
    "build:ext": "esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --outfile=dist/extension.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "cli": "tsx src/cli.ts",
    "eval": "tsx eval/run.ts",
    "context": "tsx scripts/context.ts",
    "execute": "tsx scripts/execute.ts",
    "heal": "tsx scripts/heal.ts",
    "verify:fewshot": "tsx scripts/verify-fewshot.ts"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "openai": "^7.64.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "categories": [
    "Testing"
  ]
}
